# Example environment variables.
# For Aptible deployments: set these in Aptible configuration (dashboard or CLI).

# Prefer a single connection URL (Aptible commonly provides DATABASE_URL):
DATABASE_URL=postgres://user:password@host:5432/dbname

# Alternatively set discrete values for local development:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=changeme
DB_NAME=app_db

# When running in Aptible, you can set DB_SSL=true if required by your DB
DB_SSL=false

# App port
PORT=3000
